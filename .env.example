# Sao chép file này thành .env rồi chỉnh nếu cần
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=doi-chuoi-nay-khi-trien-khai-that
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://web:8000

POSTGRES_DB=hien_mau
POSTGRES_USER=hienmau
POSTGRES_PASSWORD=hienmau_dev_pw

# Nạp dữ liệu mẫu khi khởi động (idempotent — chạy nhiều lần không nhân bản)
# Dữ liệu mẫu dùng chung một mật khẩu công khai trong mã nguồn — ĐẶT 0 khi triển khai thật
SEED_DEMO=1

# Cổng trên máy host
WEB_HOST_PORT=8080
DB_HOST_PORT=5433
PGADMIN_HOST_PORT=5050
PGADMIN_EMAIL=admin@hienmau.vn
PGADMIN_PASSWORD=admin123

# Chu kỳ chạy tác vụ định kỳ (giây) — container scheduler
JOBS_INTERVAL_SECONDS=300

# Trợ lý hỏi đáp (chatbot). Để trống ANTHROPIC_API_KEY → chạy chế độ từ khóa, không cần AI, không tốn phí.
# Có key → dùng Claude (mặc định claude-haiku-5-5, rẻ & nhanh). KHÔNG commit key thật — chỉ đặt trong .env
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-haiku-5-5
# Để trống = API chính thức Anthropic. Dịch vụ trung gian tương thích /v1/messages: ghi địa chỉ gốc, vd https://api.example.com
CHATBOT_BASE_URL=
CHATBOT_RATE_LIMIT=20
# Nhiều người hỏi cùng lúc: tối đa N câu gửi AI song song (vượt → trả lời ngay bằng chế độ từ khóa), hạn mức gọi AI / ngày
CHATBOT_MAX_CONCURRENT=8
CHATBOT_DAILY_LIMIT=2000

# Cổng quản trị (không có liên kết công khai). Khi chạy thật: đổi đường dẫn thành chuỗi khó đoán và giới hạn IP.
# ADMIN_ALLOWED_IPS trống = không giới hạn; nhiều IP cách nhau dấu phẩy. IP lấy theo TRUSTED_PROXY_COUNT.
ADMIN_LOGIN_PATH=quan-tri/dang-nhap
ADMIN_ALLOWED_IPS=

# Bản đồ Goong (account.goong.io/keys): Map key hiển thị bản đồ, API key tra địa chỉ / chỉ đường (chỉ máy chủ dùng)
GOONG_MAP_KEY=
GOONG_API_KEY=
