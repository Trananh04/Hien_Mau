# Sao chép file này thành .env rồi chỉnh nếu cần
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=doi-chuoi-nay-khi-trien-khai-that
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://web:8000

POSTGRES_DB=hien_mau
POSTGRES_USER=hienmau
POSTGRES_PASSWORD=hienmau_dev_pw

# Nạp dữ liệu mẫu khi khởi động (idempotent — chạy nhiều lần không nhân bản)
# Dữ liệu mẫu dùng chung một mật khẩu công khai trong mã nguồn — ĐẶT 0 khi triển khai thật
SEED_DEMO=1

# Cổng trên máy host
WEB_HOST_PORT=8080
DB_HOST_PORT=5433
PGADMIN_HOST_PORT=5050
PGADMIN_EMAIL=admin@hienmau.vn
PGADMIN_PASSWORD=admin123

# Chu kỳ chạy tác vụ định kỳ (giây) — container scheduler
JOBS_INTERVAL_SECONDS=300
